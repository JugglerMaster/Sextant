# Sextant server environment
# Keep this file mode 0600. On systemd: chown root:sextant /etc/sextant.env

SEXTANT_DATA_DIR=/var/lib/sextant
SEXTANT_PUBLIC_URL=https://ops.example.com
SEXTANT_COOKIE_SECURE=1
SEXTANT_TRUST_PROXY=1

# Bootstrap administrator. Only used when the database has no users.
# Prefer the auto-generated bootstrap file on first start.
# SEXTANT_ADMIN_USER=admin
# SEXTANT_ADMIN_PASSWORD=use-a-password-manager

# Optional: override the generated server secret (at least 32 high-entropy bytes).
# SEXTANT_SECRET_KEY=
# SEXTANT_SESSION_HOURS=12
# SEXTANT_OFFLINE_AFTER_SECONDS=90
# SEXTANT_ENROLLMENT_TTL_MINUTES=30

# Allowed Host header values (CSV). Derived from SEXTANT_PUBLIC_URL when unset.
# Set explicitly when the console is reached by several names/IPs. "*" disables.
# SEXTANT_ALLOWED_HOSTS=ops.example.com,127.0.0.1,localhost

# Command queue guardrails.
# reject = do not accept new work for an offline agent; queue = hold until heartbeat.
# SEXTANT_OFFLINE_COMMAND_POLICY=queue
# SEXTANT_MAX_QUEUED_COMMANDS_PER_AGENT=50
# SEXTANT_DISPATCHED_GRACE_SECONDS=120
# SEXTANT_QUEUED_COMMAND_TTL_HOURS=24
# SEXTANT_SESSION_CLEANUP_DAYS=7
# SEXTANT_COMMAND_OUTPUT_LIMIT=200000
# SEXTANT_COMMAND_RETENTION_DAYS=90
# SEXTANT_AUDIT_RETENTION_DAYS=365

# Telemetry history (SQLite). Retention is 1-365 days; HISTORY=0 disables inserts/pruning.
# SEXTANT_TELEMETRY_RETENTION_DAYS=7
# SEXTANT_TELEMETRY_HISTORY=1

# Network discovery (D1-D2). Off by default. Enabling also requires an admin to
# record the audited "I am authorized to scan these networks" acknowledgement in
# the Discovery page. Only private RFC1918/ULA CIDRs are accepted.
# SEXTANT_DISCOVERY_ENABLED=0
# SEXTANT_DISCOVERY_CIDRS=192.168.1.0/24
# SEXTANT_DISCOVERY_EXCLUDE=192.168.1.1/32
# SEXTANT_DISCOVERY_METHODS=neigh,dns,oui,ssdp
# SEXTANT_DISCOVERY_PROBE_PORTS=22,53,80,139,443,445,631,1883,3389,5900,5985,5986,8006,8080,8443,9100,32400
# SEXTANT_DISCOVERY_ACTIVE_PROBES=0
# SEXTANT_DISCOVERY_INTERVAL_HOURS=0
# SEXTANT_DISCOVERY_MAX_HOSTS=1024
# SEXTANT_DISCOVERY_CONCURRENCY=32
# SEXTANT_DISCOVERY_TIMEOUT_MS=600
# SEXTANT_DISCOVERY_RETENTION_DAYS=90
# Agent-relayed scans (D3). Also require profile modules.discovery, per-agent
# policy allow_discovery, and the local agent ALLOW_DISCOVERY=1 / --allow-discovery.
# SEXTANT_DISCOVERY_AGENT_RELAY=0
# SEXTANT_DISCOVERY_EXPORT_LIMIT=10000
# External imports, SNMP, and vendor connectors are configured in the Discovery
# page by an admin. They are off by default. Connector secrets are write-only,
# held in process memory, and are not persisted to the database or environment.

# Docker Hosts + Compose Files. Agent access is still gated by local config + profile.
# SEXTANT_DOCKER_ENABLED=1
# SEXTANT_DOCKER_INVENTORY_MAX_BYTES=2000000
# SEXTANT_DOCKER_INVENTORY_STALE_SECONDS=900
# Set this to lock the Compose library path; otherwise admins can edit it in the UI.
# SEXTANT_DOCKER_COMPOSE_DIR=/var/lib/sextant/docker/compose
# SEXTANT_DOCKER_MAX_FILE_BYTES=262144
# SEXTANT_DOCKER_MAX_FILES=16
# SEXTANT_DOCKER_MAX_TOTAL_BYTES=1048576
# SEXTANT_DOCKER_MAX_BUNDLE_BYTES=4194304
# SEXTANT_DOCKER_DEPLOYMENT_RETENTION_DAYS=90
# SEXTANT_DOCKER_CONSOLE_POLL_SECONDS=25
# SEXTANT_DOCKER_CONSOLE_IDLE_SECONDS=900
# SEXTANT_DOCKER_CONSOLE_MAX_SESSIONS=2
# SEXTANT_DOCKER_CONSOLE_MAX_INPUT_BYTES=65536
# SEXTANT_DOCKER_CONSOLE_MAX_OUTPUT_BYTES=1048576

# Package store (Tier 0: SHA-256 integrity, no signatures).
# SEXTANT_STORE_ENABLED=1
# SEXTANT_STORE_MAX_BLOB_MB=512
# SEXTANT_STORE_MAX_TOTAL_GB=20

# Server update check (notify-only in this version). Use github:owner/repo or a JSON URL.
# SEXTANT_UPDATE_FEED=github:owner/repo
# SEXTANT_UPDATE_CHECK_HOURS=6
# SEXTANT_GITHUB_TOKEN=

# Telegram notifications. Create a bot with @BotFather, start a chat with it,
# and put the bot token and chat id here. Keep this file mode 0600.
# SEXTANT_NOTIFY_ENABLED=1
# SEXTANT_TELEGRAM_ENABLED=1
# SEXTANT_TELEGRAM_BOT_TOKEN=123456789:AA...
# SEXTANT_TELEGRAM_CHAT_ID=123456789
# SEXTANT_TELEGRAM_THREAD_ID=
# Events: offline,disk,memory,gpu,service
# SEXTANT_TELEGRAM_EVENTS=offline,disk,memory,gpu,service
# SEXTANT_TELEGRAM_MIN_SEVERITY=warning
# SEXTANT_TELEGRAM_RECOVERY=1
# SEXTANT_NOTIFY_INTERVAL_SECONDS=20
# SEXTANT_NOTIFICATION_RETENTION_DAYS=90

# Remote install over SSH (Linux, key-based) or WinRM/HTTPS (Windows, pywinrm extra).
# SEXTANT_SSH_INSTALL_ENABLED=1
# SEXTANT_SSH_KEY_PATH=/var/lib/sextant/ssh/install_key
# SEXTANT_WINDOWS_INSTALL_ENABLED=1
# SEXTANT_WINDOWS_INSTALL_CA_FILE=/etc/ssl/certs/corp-root-ca.pem
# SEXTANT_WINDOWS_INSTALL_TIMEOUT_SECONDS=600

# Active Directory / Samba AD over LDAPS.
# Requires the optional dependency: pip install 'sextant[ldap]'
# SEXTANT_LDAP_ENABLED=1
# SEXTANT_LDAP_SERVER=dc1.corp.example.com
# SEXTANT_LDAP_PORT=636
# SEXTANT_LDAP_USE_SSL=1
# SEXTANT_LDAP_CA_CERT=/etc/ssl/certs/corp-root-ca.pem
# SEXTANT_LDAP_BASE_DN=DC=corp,DC=example,DC=com
# SEXTANT_LDAP_BIND_DN=CN=sextant,OU=Service Accounts,DC=corp,DC=example,DC=com
# SEXTANT_LDAP_BIND_PASSWORD=use-a-password-manager
# SEXTANT_LDAP_USER_FILTER=(sAMAccountName={username})
# SEXTANT_LDAP_ADMIN_GROUPS=CN=RC Admins,OU=Groups,DC=corp,DC=example,DC=com
# SEXTANT_LDAP_OPERATOR_GROUPS=CN=RC Operators,OU=Groups,DC=corp,DC=example,DC=com
# SEXTANT_LDAP_VIEWER_GROUPS=CN=RC Viewers,OU=Groups,DC=corp,DC=example,DC=com
# SEXTANT_LDAP_DEFAULT_ROLE=viewer
