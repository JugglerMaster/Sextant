# Runner Control server environment
# Keep this file mode 0600. On systemd: chown root:runner-control /etc/runner-control.env

RC_DATA_DIR=/var/lib/runner-control
RC_PUBLIC_URL=https://ops.example.com
RC_COOKIE_SECURE=1
RC_TRUST_PROXY=1

# Bootstrap administrator. Only used when the database has no users.
# Prefer the auto-generated bootstrap file on first start.
# RC_ADMIN_USER=admin
# RC_ADMIN_PASSWORD=use-a-password-manager

# Optional: override the generated server secret (at least 32 high-entropy bytes).
# RC_SECRET_KEY=
# RC_SESSION_HOURS=12
# RC_OFFLINE_AFTER_SECONDS=90
# RC_ENROLLMENT_TTL_MINUTES=30

# Allowed Host header values (CSV). Derived from RC_PUBLIC_URL when unset.
# Set explicitly when the console is reached by several names/IPs. "*" disables.
# RC_ALLOWED_HOSTS=ops.example.com,127.0.0.1,localhost

# Command queue guardrails.
# reject = do not accept new work for an offline agent; queue = hold until heartbeat.
# RC_OFFLINE_COMMAND_POLICY=queue
# RC_MAX_QUEUED_COMMANDS_PER_AGENT=50
# RC_DISPATCHED_GRACE_SECONDS=120
# RC_QUEUED_COMMAND_TTL_HOURS=24
# RC_SESSION_CLEANUP_DAYS=7
# RC_COMMAND_RETENTION_DAYS=90
# RC_AUDIT_RETENTION_DAYS=365

# Telemetry history (SQLite). Retention is 1-365 days; HISTORY=0 disables inserts/pruning.
# RC_TELEMETRY_RETENTION_DAYS=7
# RC_TELEMETRY_HISTORY=1

# Package store (Tier 0: SHA-256 integrity, no signatures).
# RC_STORE_ENABLED=1
# RC_STORE_MAX_BLOB_MB=512
# RC_STORE_MAX_TOTAL_GB=20

# Server update check (notify-only in this version). Use github:owner/repo or a JSON URL.
# RC_UPDATE_FEED=github:owner/repo
# RC_UPDATE_CHECK_HOURS=6
# RC_GITHUB_TOKEN=

# Remote install over SSH (Linux only, key-based, one job at a time).
# RC_SSH_INSTALL_ENABLED=1
# RC_SSH_KEY_PATH=/var/lib/runner-control/ssh/install_key

# Active Directory / Samba AD over LDAPS.
# Requires the optional dependency: pip install 'runner-control[ldap]'
# RC_LDAP_ENABLED=1
# RC_LDAP_SERVER=dc1.corp.example.com
# RC_LDAP_PORT=636
# RC_LDAP_USE_SSL=1
# RC_LDAP_CA_CERT=/etc/ssl/certs/corp-root-ca.pem
# RC_LDAP_BASE_DN=DC=corp,DC=example,DC=com
# RC_LDAP_BIND_DN=CN=runner-control,OU=Service Accounts,DC=corp,DC=example,DC=com
# RC_LDAP_BIND_PASSWORD=use-a-password-manager
# RC_LDAP_USER_FILTER=(sAMAccountName={username})
# RC_LDAP_ADMIN_GROUPS=CN=RC Admins,OU=Groups,DC=corp,DC=example,DC=com
# RC_LDAP_OPERATOR_GROUPS=CN=RC Operators,OU=Groups,DC=corp,DC=example,DC=com
# RC_LDAP_VIEWER_GROUPS=CN=RC Viewers,OU=Groups,DC=corp,DC=example,DC=com
# RC_LDAP_DEFAULT_ROLE=viewer
